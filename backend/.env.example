# Azure OpenAI Configuration (Required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-ada-002
OPENAI_API_VERSION=2024-08-01-preview

# Database
DATABASE_URL=sqlite:///./devsecops.db
CHROMA_PERSIST_DIR=./chroma_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Azure AD SSO Configuration (Optional - for Single Sign-On)
# To enable SSO, register an app in Azure AD and fill in these values:
# 1. Go to Azure Portal > Azure Active Directory > App registrations
# 2. Create a new registration with redirect URI: http://localhost:5173/auth/callback
# 3. Under "Certificates & secrets", create a new client secret
# 4. Copy the Application (client) ID, Directory (tenant) ID, and secret value
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:5173/auth/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# LangSmith Tracing (Optional - for observability)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devsecops-chat
LANGSMITH_ORG_ID=
LANGSMITH_PROJECT_ID=
